[Unit]
Description=PV-Controller Web Interface (Produktion)
After=network.target

[Service]
Type=simple
User=openhabian
WorkingDirectory=/home/openhabian/pvcontroller-prod
ExecStart=/home/openhabian/pvcontroller-prod/.venv/bin/uvicorn web:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
